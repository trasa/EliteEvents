#!/bin/bash
# Rolls a pushed version out to the DOKS cluster. Takes the image tag as its only argument.
#   ./deploy-k8s 1.0.0-alpha.g1a2b3c4
set -euo pipefail

VERSION="${1:-${VERSION:-$(cat .image-version 2>/dev/null || true)}}"
NAMESPACE="${NAMESPACE:-elite}"
KUSTOMIZATION="k8s/kustomization.yaml"

if [ -z "$VERSION" ]; then
    echo "Usage: ./deploy-k8s <image-tag>" >&2
    exit 1
fi

# The tag goes into the kustomize images transformer, and `kubectl apply -k` is then the entire
# deploy. It used to be applied as committed and re-pinned afterwards with `kubectl set image`,
# which had two costs. Committed YAML said `:latest`, so *any* bare `kubectl apply -k k8s/` — an
# ingress tweak, a config change, someone reconciling state — silently reset both Deployments to
# `:latest` and rolled production off whatever was pinned. And `set image` created a second field
# manager owning `.spec.template.spec.containers[].image`, so the manifests and the cluster
# disagreed about who decides the version.
#
# Writing the tag here instead means a clean checkout applies to exactly what is running, so a
# bare apply is a genuine no-op. Commit the change: this file is how the repo records what is
# deployed.
# Backed up as a file rather than a shell variable: $(cat ...) strips trailing newlines, so
# restoring from one would "revert" to a subtly different file.
backup="$(mktemp)"
trap 'rm -f "$backup"' EXIT
cp "$KUSTOMIZATION" "$backup"

tmp="$(mktemp)"
sed -E "s|^([[:space:]]*newTag:[[:space:]]*).*$|\1${VERSION}|" "$KUSTOMIZATION" > "$tmp"
mv "$tmp" "$KUSTOMIZATION"

# Never deploy a half-substituted manifest. The two images are pinned in two different files —
# the web tag by the sed above, the ingestion tag by hand in k8s/25-feedlistener.yaml, which the
# FeedListener controller reads and kustomize's images: block does not touch. Requiring both to
# carry this VERSION is what stops a deploy that ships one tier and silently leaves the other on
# the previous build.
rendered="$(kubectl kustomize k8s/)"
web_pinned="$(printf '%s\n' "$rendered" | grep -cE "image: registry\.digitalocean\.com/meancat/elite-web:${VERSION}$" || true)"
ingestion_pinned="$(printf '%s\n' "$rendered" | grep -cE "image: registry\.digitalocean\.com/meancat/elite-ingestion:${VERSION}$" || true)"
if [ "$web_pinned" -lt 1 ] || [ "$ingestion_pinned" -lt 1 ]; then
    cp "$backup" "$KUSTOMIZATION"
    echo "Refusing to deploy: expected both images pinned to ${VERSION}." >&2
    echo "  elite-web:       ${web_pinned} (from ${KUSTOMIZATION} images: block)" >&2
    echo "  elite-ingestion: ${ingestion_pinned} (from k8s/25-feedlistener.yaml spec.image)" >&2
    echo "Reverted ${KUSTOMIZATION}. An ingestion upgrade is a hand edit to spec.image." >&2
    exit 1
fi

kubectl apply -k k8s/

# Ingestion first: each shard is a single writer with strategy Recreate, so it is briefly down and
# the rollout should be seen through before the web tier starts.
#
# The shards are named by the FeedListener controller (eddn-0, eddn-1, ...), not by any manifest
# here, so they are discovered by label rather than named. `rollout status` takes no selector.
shards="$(kubectl -n "$NAMESPACE" get deploy \
    -l app.kubernetes.io/name=feed-listener \
    -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}')"
if [ -z "$shards" ]; then
    echo "Refusing to report success: no feed-listener shards found in ${NAMESPACE}." >&2
    echo "Is the operator running, and is k8s/25-feedlistener.yaml in kustomization.yaml?" >&2
    exit 1
fi
for shard in $shards; do
    kubectl -n "$NAMESPACE" rollout status "deployment/${shard}" --timeout=5m
done

kubectl -n "$NAMESPACE" rollout status deployment/web --timeout=5m

echo "Deployed ${VERSION}"

if ! git diff --quiet -- "$KUSTOMIZATION" 2>/dev/null; then
    echo
    echo "NOTE: ${KUSTOMIZATION} now pins ${VERSION}. Commit it so the repo matches the cluster:"
    echo "  git commit -m 'Deploy ${VERSION}' -- ${KUSTOMIZATION}"
fi
