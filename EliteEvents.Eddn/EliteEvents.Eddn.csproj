<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    
    <ItemGroup>
        <!-- MessageShardFilter.StableHash is internal but pinned by test: the hash has to stay
             byte-identical across releases or a rolling update repartitions the feed mid-flight. -->
        <InternalsVisibleTo Include="EliteEvents.Eddn.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Cronos" Version="0.11.1" />
        <PackageReference Include="Iconic.Zlib.Netstandard" Version="1.0.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.2" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.2" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" version="10.0.2" />
        <PackageReference Include="NetMQ" Version="4.0.4.2" />
        <PackageReference Include="Newtonsoft.Json" Version="$(NewtonsoftJsonVersion)" />
        <PackageReference Include="StackExchange.Redis" Version="2.10.1" />
    </ItemGroup>
    
    <!-- Generated clients are gitignored, so they exist locally only after a Debug build. A clean
         checkout (CI, or a container build) has none, and Release used to skip generation entirely
         — which meant any build that didn't start from a developer's working tree failed to
         compile. Generate whenever the output is missing, whatever the configuration. -->
    <Target Name="NSwag" BeforeTargets="CoreCompile"
            Condition="'$(Configuration)' == 'Debug' Or !Exists('$(ProjectDir)Generated/Journal.g.cs') Or !Exists('$(ProjectDir)Generated/ApproachSettlement.g.cs')">
        <Exec WorkingDirectory="$(ProjectDir)" Command="dotnet nswag jsonschema2csclient /name:JournalMessage /namespace:EliteEvents.Eddn.Journal /input:https://eddn.edcd.io/schemas/journal/1 /output:Generated/Journal.g.cs " />
        <Exec WorkingDirectory="$(ProjectDir)" Command="dotnet nswag jsonschema2csclient /name:ApproachSettlementMessage /namespace:EliteEvents.Eddn.ApproachSettlement /input:https://eddn.edcd.io/schemas/approachsettlement/1 /output:Generated/ApproachSettlement.g.cs " />
        <ReplaceIntWithLong Files="$(ProjectDir)Generated/ApproachSettlement.g.cs;$(ProjectDir)Generated/Journal.g.cs" />

        <!-- The default **/*.cs glob is expanded when the project loads, so files this target has
             just created are not in @(Compile) yet. Re-adding them here is what lets a build
             generate and compile them in one pass; Remove first keeps it idempotent for the
             usual case where they already existed. -->
        <!-- Paths must be relative here: the default glob yields items like
             "Generated/Journal.g.cs", so an absolute Remove matches nothing and the Include then
             adds a duplicate (CS2002). -->
        <ItemGroup>
            <Compile Remove="Generated/*.g.cs" />
            <Compile Include="Generated/*.g.cs" />
        </ItemGroup>
    </Target>

    <!-- HACK: Replace all 'public int' with 'public long' in generated files 
    Because I can't get the nswag.json to output correctly, and the jsonschema2csclient doesn't support overriding int type.
    (That I can find, anyway.)
    -->
    <UsingTask TaskName="ReplaceIntWithLong" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System.IO" />
            <Using Namespace="System.Text.RegularExpressions" />
            <Code Type="Fragment" Language="cs">
                <![CDATA[
            foreach (var file in Files)
            {
                Console.WriteLine($"Processing file: {file.ItemSpec}");
                var path = file.ItemSpec;
                if (File.Exists(path))
                {
                    var content = File.ReadAllText(path);
                    content = Regex.Replace(content, @"\bpublic int\b", "public long");
                    content = Regex.Replace(content, @"\bpublic int\?\b", "public long?");
                    File.WriteAllText(path, content);
                }
            }
            ]]>
            </Code>
        </Task>
    </UsingTask>
</Project>
