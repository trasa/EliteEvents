@* Results card for a system search. The page renders it directly for a plain GET
   (/system-search?q=sol) and the htmx fragment endpoint returns it on its own for a live swap. *@

@if (ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@ErrorMessage</div>
}
else if (string.IsNullOrWhiteSpace(Query))
{
    <!-- nothing searched for yet -->
}
else if (Systems is null || Systems.Count == 0)
{
    <div class="alert alert-info mt-3">
        No systems found matching: <strong>@Query</strong>
    </div>
}
else
{
    <div class="card mt-3">
        <div class="card-header">
            <h4 class="mb-0">Matching Systems</h4>
            <small class="text-muted">Found @Systems.Count system(s) matching "@Query"</small>
        </div>
        <div class="card-body">
            <div class="list-group">
                @foreach (var system in Systems)
                {
                    <a href="/system/@Uri.EscapeDataString(system)"
                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-1">@system</h5>
                            <small class="text-muted">Click to view station details</small>
                        </div>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? Query { get; set; }

    [Parameter] public IReadOnlyList<string>? Systems { get; set; }

    [Parameter] public string? ErrorMessage { get; set; }
}
